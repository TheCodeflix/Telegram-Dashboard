# ─── Telegram API ─────────────────────────────────────────────────────────────
# Get from https://my.telegram.org/apps
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
# Get from @BotFather on Telegram
BOT_TOKEN=123456789:AABBccDDeEFfgGHhIijjKK
BOT_OWNER=123456789

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# MongoDB connection URI (e.g. MongoDB Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
DATABASE_NAME=telegram_dashboard

# ─── Flask ────────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=your-random-secret-key-here
SESSION_SECRET=your-random-secret-key-here
FLASK_ENV=production

# ─── App Settings ─────────────────────────────────────────────────────────────
# Your deployed app domain (used for generating dashboard links)
DOMAIN=https://your-app.koyeb.app

# Server port (default: 8000)
PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Session expiry in hours (0 = no expiry)
SESSION_MAX_AGE_HOURS=0
